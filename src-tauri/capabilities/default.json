{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window and the selection overlay",
  "windows": [
    "main",
    "overlay"
  ],
  "permissions": [
    "core:default",
    "core:app:allow-version",
    "core:event:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:window:allow-destroy",
    "core:window:allow-available-monitors",
    "core:window:allow-current-monitor",
    "core:window:allow-primary-monitor",
    "core:window:allow-cursor-position",
    "core:window:allow-scale-factor",
    "core:window:allow-outer-position",
    "core:window:allow-inner-size",
    "dialog:allow-open",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-video-write-recursive",
    "fs:allow-video-read-recursive",
    "fs:allow-temp-write-recursive",
    "fs:allow-temp-read-recursive",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/ffmpeg",
          "sidecar": true,
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/ffmpeg",
          "sidecar": true,
          "args": true
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/*" },
        { "url": "https://ko-fi.com/*" }
      ]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill"
  ]
}